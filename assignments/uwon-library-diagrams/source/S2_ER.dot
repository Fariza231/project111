digraph ER { graph [rankdir=LR, nodesep=0.5, ranksep=1.1, splines=spline, bgcolor="white", pad=0.3]; node [shape=plain,fontname="Helvetica",fontsize=10]; edge [fontname="Helvetica",fontsize=9,arrowsize=0.7];
PATRON [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E8F0F6"><B>PATRON</B></TD></TR><TR><TD ALIGN="LEFT">PK patron_id</TD></TR><TR><TD ALIGN="LEFT">UK university_ref</TD></TR><TR><TD ALIGN="LEFT">email</TD></TR><TR><TD ALIGN="LEFT">category</TD></TR><TR><TD ALIGN="LEFT">active</TD></TR><TR><TD ALIGN="LEFT">FK policy_id</TD></TR></TABLE>>];
LOAN_POLICY [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E8F0F6"><B>LOAN_POLICY</B></TD></TR><TR><TD ALIGN="LEFT">PK policy_id</TD></TR><TR><TD ALIGN="LEFT">UK patron_category</TD></TR><TR><TD ALIGN="LEFT">max_active_loans</TD></TR><TR><TD ALIGN="LEFT">loan_period_days</TD></TR></TABLE>>];
RESOURCE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E8F0F6"><B>RESOURCE</B></TD></TR><TR><TD ALIGN="LEFT">PK resource_id</TD></TR><TR><TD ALIGN="LEFT">kind: Book / Proceedings / Journal</TD></TR><TR><TD ALIGN="LEFT">title</TD></TR><TR><TD ALIGN="LEFT">standard_identifier</TD></TR><TR><TD ALIGN="LEFT">searchable_text</TD></TR></TABLE>>];
DEPARTMENT [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E8F0F6"><B>DEPARTMENT</B></TD></TR><TR><TD ALIGN="LEFT">PK department_id</TD></TR><TR><TD ALIGN="LEFT">name</TD></TR><TR><TD ALIGN="LEFT">library_location</TD></TR></TABLE>>];
COPY [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E8F0F6"><B>COPY</B></TD></TR><TR><TD ALIGN="LEFT">PK copy_id</TD></TR><TR><TD ALIGN="LEFT">FK resource_id</TD></TR><TR><TD ALIGN="LEFT">FK department_id</TD></TR><TR><TD ALIGN="LEFT">unit_label: edition / issue / volume</TD></TR><TR><TD ALIGN="LEFT">shelf_location</TD></TR><TR><TD ALIGN="LEFT">availability</TD></TR><TR><TD ALIGN="LEFT">condition</TD></TR></TABLE>>];
RESERVATION [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E8F0F6"><B>RESERVATION</B></TD></TR><TR><TD ALIGN="LEFT">PK reservation_id</TD></TR><TR><TD ALIGN="LEFT">FK patron_id</TD></TR><TR><TD ALIGN="LEFT">FK resource_id</TD></TR><TR><TD ALIGN="LEFT">FK allocated_copy_id [nullable]</TD></TR><TR><TD ALIGN="LEFT">requested_at</TD></TR><TR><TD ALIGN="LEFT">status: Waiting / Ready / Fulfilled / Cancelled</TD></TR></TABLE>>];
LOAN [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E8F0F6"><B>LOAN</B></TD></TR><TR><TD ALIGN="LEFT">PK loan_id</TD></TR><TR><TD ALIGN="LEFT">FK patron_id</TD></TR><TR><TD ALIGN="LEFT">FK copy_id</TD></TR><TR><TD ALIGN="LEFT">FK reservation_id [nullable, unique]</TD></TR><TR><TD ALIGN="LEFT">issued_at / due_at</TD></TR><TR><TD ALIGN="LEFT">returned_at [nullable]</TD></TR><TR><TD ALIGN="LEFT">condition_out</TD></TR><TR><TD ALIGN="LEFT">condition_in [nullable until returned]</TD></TR></TABLE>>];
PATRON -> LOAN [dir=none,label="borrows",taillabel="1",headlabel="0..*",labeldistance=2.0,labelangle=28];
COPY -> LOAN [dir=none,label="loan history",taillabel="1",headlabel="0..*",labeldistance=2.0,labelangle=28];
RESOURCE -> COPY [dir=none,label="has",taillabel="1",headlabel="0..*",labeldistance=2.0,labelangle=28];
DEPARTMENT -> COPY [dir=none,label="owns",taillabel="1",headlabel="0..*",labeldistance=2.0,labelangle=28];
PATRON -> RESERVATION [dir=none,label="places",taillabel="1",headlabel="0..*",labeldistance=2.0,labelangle=28];
RESOURCE -> RESERVATION [dir=none,label="requested title",taillabel="1",headlabel="0..*",labeldistance=2.0,labelangle=28];
COPY -> RESERVATION [dir=none,label="allocated copy",taillabel="0..1",headlabel="0..*",labeldistance=2.0,labelangle=28];
RESERVATION -> LOAN [dir=none,label="fulfilled by",taillabel="0..1",headlabel="0..1",labeldistance=2.0,labelangle=28];
LOAN_POLICY -> PATRON [dir=none,label="governs category",taillabel="1",headlabel="0..*",labeldistance=2.0,labelangle=28];
}

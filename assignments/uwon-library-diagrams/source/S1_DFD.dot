digraph DFD { graph [rankdir=TB, nodesep=0.65, ranksep=1.0, splines=spline, pad=0.4, bgcolor="white"]; node [fontname="Helvetica",fontsize=11]; edge [fontname="Helvetica",fontsize=11,arrowsize=0.65];
Patron [shape=box,label="Library Patron",style=solid];
Email [shape=box,label="Email Gateway",style=solid];
subgraph cluster_UWON { label="UWON Library System — logical data-flow boundary"; color="#A8BCCC"; fontname="Helvetica"; fontsize=12;
p11 [shape=box,style="rounded,filled",fillcolor="#EDF3F8",label="1.1 Authorize patron"];
p12 [shape=box,style="rounded,filled",fillcolor="#EDF3F8",label="1.2 Search catalogue"];
p13 [shape=box,style="rounded,filled",fillcolor="#EDF3F8",label="1.3 Reserve resource"];
p14 [shape=box,style="rounded,filled",fillcolor="#EDF3F8",label="1.4 Notify patron"];
D1 [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BORDER="1">D1</TD><TD BORDER="1" SIDES="TB">Patrons</TD></TR></TABLE>>];
D2 [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BORDER="1">D2</TD><TD BORDER="1" SIDES="TB">Resources + Subjects</TD></TR></TABLE>>];
D3 [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BORDER="1">D3</TD><TD BORDER="1" SIDES="TB">Copies + Departments</TD></TR></TABLE>>];
D4 [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BORDER="1">D4</TD><TD BORDER="1" SIDES="TB">Reservations</TD></TR></TABLE>>];
}
Patron -> p11 [label="F01"];
D1 -> p11 [label="F02"];
p11 -> Patron [label="F03"];
p11 -> p12 [label="F04"];
D2 -> p12 [label="F05"];
D3 -> p12 [label="F06"];
p12 -> Patron [label="F07"];
Patron -> p13 [label="F08"];
D1 -> p13 [label="F09"];
D3 -> p13 [label="F10"];
D4 -> p13 [label="F11"];
p13 -> D4 [label="F12"];
p13 -> D3 [label="F13"];
p13 -> Patron [label="F14"];
p13 -> p14 [label="F15"];
p14 -> Email [label="F16"];
Email -> p14 [label="F17"];
p14 -> Patron [label="F18"];
}

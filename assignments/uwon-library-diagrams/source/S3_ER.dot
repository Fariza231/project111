digraph ER { graph [rankdir=LR, nodesep=0.5, ranksep=1.1, splines=spline, bgcolor="white", pad=0.3]; node [shape=plain,fontname="Helvetica",fontsize=10]; edge [fontname="Helvetica",fontsize=9,arrowsize=0.7];
PATRON [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E8F0F6"><B>PATRON</B></TD></TR><TR><TD ALIGN="LEFT">PK patron_id</TD></TR><TR><TD ALIGN="LEFT">UK university_ref</TD></TR><TR><TD ALIGN="LEFT">email</TD></TR><TR><TD ALIGN="LEFT">category</TD></TR><TR><TD ALIGN="LEFT">active</TD></TR></TABLE>>];
RESOURCE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E8F0F6"><B>RESOURCE</B></TD></TR><TR><TD ALIGN="LEFT">PK resource_id</TD></TR><TR><TD ALIGN="LEFT">kind: Book / Proceedings / Journal</TD></TR><TR><TD ALIGN="LEFT">title</TD></TR><TR><TD ALIGN="LEFT">standard_identifier</TD></TR><TR><TD ALIGN="LEFT">searchable_text</TD></TR></TABLE>>];
PROVIDER [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E8F0F6"><B>PROVIDER</B></TD></TR><TR><TD ALIGN="LEFT">PK provider_id</TD></TR><TR><TD ALIGN="LEFT">name</TD></TR><TR><TD ALIGN="LEFT">type: Publisher / PartnerUniversity</TD></TR></TABLE>>];
ACCESS_ROUTE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E8F0F6"><B>ACCESS_ROUTE</B></TD></TR><TR><TD ALIGN="LEFT">PK route_id</TD></TR><TR><TD ALIGN="LEFT">FK resource_id</TD></TR><TR><TD ALIGN="LEFT">FK provider_id</TD></TR><TR><TD ALIGN="LEFT">provider_resource_ref</TD></TR><TR><TD ALIGN="LEFT">endpoint</TD></TR></TABLE>>];
SUBSCRIPTION [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E8F0F6"><B>SUBSCRIPTION</B></TD></TR><TR><TD ALIGN="LEFT">PK subscription_id</TD></TR><TR><TD ALIGN="LEFT">FK route_id</TD></TR><TR><TD ALIGN="LEFT">valid_from / valid_until</TD></TR><TR><TD ALIGN="LEFT">status</TD></TR><TR><TD ALIGN="LEFT">category_rule</TD></TR></TABLE>>];
AGREEMENT [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E8F0F6"><B>AGREEMENT</B></TD></TR><TR><TD ALIGN="LEFT">PK agreement_id</TD></TR><TR><TD ALIGN="LEFT">FK provider_id</TD></TR><TR><TD ALIGN="LEFT">valid_from / valid_until</TD></TR><TR><TD ALIGN="LEFT">resource_scope_rule</TD></TR><TR><TD ALIGN="LEFT">category_rule</TD></TR></TABLE>>];
ACCESS_ATTEMPT [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E8F0F6"><B>ACCESS_ATTEMPT</B></TD></TR><TR><TD ALIGN="LEFT">PK access_id</TD></TR><TR><TD ALIGN="LEFT">FK patron_id</TD></TR><TR><TD ALIGN="LEFT">FK route_id</TD></TR><TR><TD ALIGN="LEFT">FK subscription_id [nullable]</TD></TR><TR><TD ALIGN="LEFT">FK agreement_id [nullable]</TD></TR><TR><TD ALIGN="LEFT">attempted_at</TD></TR><TR><TD ALIGN="LEFT">outcome: Granted / Denied / ProviderUnavailable</TD></TR></TABLE>>];
RESOURCE -> ACCESS_ROUTE [dir=none,label="available through",taillabel="1",headlabel="0..*",labeldistance=2.0,labelangle=28];
PROVIDER -> ACCESS_ROUTE [dir=none,label="serves",taillabel="1",headlabel="0..*",labeldistance=2.0,labelangle=28];
ACCESS_ROUTE -> SUBSCRIPTION [dir=none,label="licensed by",taillabel="1",headlabel="0..*",labeldistance=2.0,labelangle=28];
PROVIDER -> AGREEMENT [dir=none,label="covered by",taillabel="1",headlabel="0..*",labeldistance=2.0,labelangle=28];
PATRON -> ACCESS_ATTEMPT [dir=none,label="requests",taillabel="1",headlabel="0..*",labeldistance=2.0,labelangle=28];
ACCESS_ROUTE -> ACCESS_ATTEMPT [dir=none,label="requested route",taillabel="1",headlabel="0..*",labeldistance=2.0,labelangle=28];
SUBSCRIPTION -> ACCESS_ATTEMPT [dir=none,label="entitlement used",taillabel="0..1",headlabel="0..*",labeldistance=2.0,labelangle=28];
AGREEMENT -> ACCESS_ATTEMPT [dir=none,label="entitlement used",taillabel="0..1",headlabel="0..*",labeldistance=2.0,labelangle=28];
}
